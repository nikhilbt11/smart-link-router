# Copy this file to .env in the repository root and fill in real values.
# Never commit the actual .env file.

# ---- Backend (Express) ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-link-router
# Set to true only when running behind a trusted reverse proxy (nginx, load balancer, etc.)
# that sets X-Forwarded-For. Leave false for local development.
TRUST_PROXY=false

# Simple env-based admin credentials (no user database/registration).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Long random string used to sign admin session JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Name of the HTTP-only cookie that stores the admin session JWT.
COOKIE_NAME=admin_token

# ---- Frontend origin (used for CORS credentials + cookie policy) ----
FRONTEND_URL=http://localhost:3000


